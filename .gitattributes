# Normalize line endings: LF in the repo, platform default on checkout
* text=auto

# Files that must keep specific line endings on every platform
*.java text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.toml text eol=lf
*.md text eol=lf
gradlew text eol=lf
*.bat text eol=crlf

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
